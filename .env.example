# PromptShield AI Environment Configuration Template
# NOTE: Phase 1 extension runs 100% locally with zero external network calls.
# These variables are reserved for future Phase 2 (backend API) & Phase 3 (dashboard).

# Environment
NODE_ENV=development
PORT=3000

# Security Engine Config
PROMPTSHIELD_DEFAULT_MODE=STRICT
PROMPTSHIELD_TELEMETRY_ENABLED=false

# Future Backend Configuration (Phase 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/promptshield_db
# API_SECRET=synthetic_secret_for_local_testing_only
