# ==============================================================================
# Aegis-AI + PromptShield AI — Environment Configuration Example
# Copy this file to gateway/.env for local deployment
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/aegis_analytics

# Authentication & Security
# WARNING: Change this secret in production!
JWT_SECRET=aegis-production-jwt-secret-replace-in-prod-2026

# Controlled Admin Provisioning Secret
# Used during registration to establish initial organization administrator accounts
ADMIN_REGISTRATION_SECRET=aegis-admin-provision-2026

# Python FastAPI Security Sidecar URL
SIDECAR_URL=http://localhost:5000/analyze
